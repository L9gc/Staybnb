@{
ViewData["Title"] = "Privacy Policy";
}

<div class="privacy-page">
    <div class="privacy-hero">
        <div class="container">
            <span class="privacy-eyebrow">YOUR PRIVACY MATTERS</span>
            <h1>Privacy Policy</h1>
            <p>
                Learn how Staybnb handles your information when you use our platform.
            </p>
            <div class="privacy-updated">
                <i class="bi bi-shield-check"></i>
                Privacy and data protection
            </div>
        </div>
    </div>

<div class="container privacy-container">
    <div class="privacy-content">

        <div class="privacy-intro">
            <p>
                Staybnb is an accommodation booking platform developed to connect
                guests with property hosts. This policy explains the types of
                information the application may collect, how that information is
                used, and the steps taken to protect it.
            </p>
        </div>

        <section class="privacy-section">
            <span class="privacy-number">01</span>
            <div>
                <h2>Information We Collect</h2>
                <p>Depending on how you use Staybnb, the application may store:</p>
                <ul>
                    <li><strong>Account information:</strong> Your name, email address and account credentials.</li>
                    <li><strong>Property information:</strong> Property descriptions, addresses, prices, types and uploaded images submitted by hosts.</li>
                    <li><strong>Booking information:</strong> Booking dates, guest numbers, booking status and calculated costs.</li>
                    <li><strong>Uploaded documents:</strong> Documents submitted as part of the guest check-in process.</li>
                    <li><strong>Communications:</strong> Messages and notifications exchanged through the platform.</li>
                    <li><strong>Activity records:</strong> Certain actions recorded by the application for administrative monitoring and accountability.</li>
                </ul>
            </div>
        </section>

        <section class="privacy-section">
            <span class="privacy-number">02</span>
            <div>
                <h2>How Information Is Used</h2>
                <p>Information stored by Staybnb supports the platform's core functionality, including:</p>
                <ul>
                    <li>Creating and managing user accounts.</li>
                    <li>Displaying properties and processing booking requests.</li>
                    <li>Reviewing host applications and managing property listings.</li>
                    <li>Supporting check-in procedures and document verification.</li>
                    <li>Delivering messages and booking-related notifications.</li>
                    <li>Maintaining administrative activity records and enforcing access permissions.</li>
                </ul>
            </div>
        </section>

        <section class="privacy-section">
            <span class="privacy-number">03</span>
            <div>
                <h2>Sharing of Information</h2>
                <p>
                    Some information must be available to authorised users for
                    Staybnb to operate. For example, property information is displayed
                    to prospective guests, while relevant booking details may be
                    available to the host responsible for that booking.
                </p>
                <p>
                    Access to guest documents and administrative information is
                    restricted according to the application's authorisation rules.
                    Users should avoid including unnecessary sensitive information
                    in messages or uploaded documents.
                </p>
            </div>
        </section>

        <section class="privacy-section">
            <span class="privacy-number">04</span>
            <div>
                <h2>Data Storage and Security</h2>
                <p>
                    Staybnb uses a database to store application information.
                    Access controls are used to restrict certain features and records
                    according to user roles and ownership.
                </p>
                <p>
                    Guest documents are stored separately from publicly accessible
                    website files and are served through authorised application
                    functionality. However, no software system can guarantee
                    absolute security.
                </p>
            </div>
        </section>

        <section class="privacy-section">
            <span class="privacy-number">05</span>
            <div>
                <h2>Account Responsibilities</h2>
                <p>
                    Users are responsible for keeping their account credentials
                    confidential and for ensuring that the information they submit
                    is accurate. If you believe your account has been accessed
                    without permission, contact the platform administrator.
                </p>
            </div>
        </section>

        <section class="privacy-section">
            <span class="privacy-number">06</span>
            <div>
                <h2>Data Retention</h2>
                <p>
                    Information may remain stored while it is needed to operate
                    the application, maintain booking records or support
                    administrative processes. The exact retention period depends
                    on the data and the application's configuration.
                </p>
            </div>
        </section>

        <section class="privacy-section">
            <span class="privacy-number">07</span>
            <div>
                <h2>Your Privacy</h2>
                <p>
                    Users should only submit information necessary for the
                    intended purpose. Requests concerning personal information
                    can be directed to the platform administrator.
                </p>
            </div>
        </section>

        <div class="privacy-contact">
            <div class="privacy-contact-icon">
                <i class="bi bi-envelope"></i>
            </div>
            <div>
                <h2>Questions about privacy?</h2>
                <p>
                    Contact the Staybnb platform administrator for questions
                    about information stored by the application.
                </p>
            </div>
        </div>

        <div class="privacy-disclaimer">
            <i class="bi bi-info-circle"></i>
            <p>
                This privacy policy is an initial description of the Staybnb
                application's data handling. Before public deployment, it should
                be reviewed against the actual implementation and applicable
                privacy legislation, including South Africa's Protection of
                Personal Information Act (POPIA), where applicable.
            </p>
        </div>

        <div class="privacy-back">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-arrow-left"></i>
                Back to Home
            </a>
        </div>

    </div>
</div>

</div>
