@model Staybnb.Models.HostApplication

@{
ViewData["Title"] = "Review Host Application";
}

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Review Host Application</h1>

    <a asp-controller="Admin"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Back to Dashboard
    </a>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info">
        @TempData["Message"]
    </div>
}

<div class="card mb-4">
    <div class="card-header">
        <h4 class="mb-0">Property Details</h4>
    </div>

    <div class="card-body">
        <h3>@Model.Title</h3>

        <p>
            <strong>Description:</strong><br />
            @Model.Description
        </p>

        <p>
            <strong>Property Type:</strong>
            @Model.PropertyType
        </p>

        <p>
            <strong>Address:</strong>
            @Model.Address
        </p>

        <p>
            <strong>City:</strong>
            @Model.City
        </p>

        <p>
            <strong>Price Per Night:</strong>
            R @Model.PricePerNight.ToString("N2")
        </p>

        <p>
            <strong>Application Status:</strong>
            <span class="badge bg-warning text-dark">
                @Model.Status
            </span>
        </p>

        <p>
            <strong>Date Submitted:</strong>
            @Model.SubmittedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
        </p>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">
        <h4 class="mb-0">Applicant Information</h4>
    </div>

    <div class="card-body">
        <p>
            <strong>Name:</strong>
            @(Model.Applicant?.FullName ?? "Unknown applicant")
        </p>

        <p>
            <strong>Email:</strong>
            @(Model.Applicant?.Email ?? "No email available")
        </p>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">
        <h4 class="mb-0">Property Images</h4>
    </div>

    <div class="card-body">
        @if (Model.Images != null && Model.Images.Any())
        {
            <div class="row">
                @foreach (var image in Model.Images)
                {
                    <div class="col-md-4 mb-3">
                        <img src="@image.ImagePath"
                             alt="Proposed property image"
                             class="img-fluid rounded border"
                             style="width: 100%; height: 240px; object-fit: cover;" />
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-warning">
                No images have been uploaded for this application.
            </div>
        }
    </div>
</div>

<div class="alert alert-info">
    <strong>Review carefully:</strong>
    Confirm that the property information and images are suitable
    before making a decision.
</div>

@if (Model.Status == "Pending")
{
    <div class="d-flex gap-2">
        <form asp-controller="Admin"
              asp-action="ApproveApplication"
              asp-route-id="@Model.Id"
              method="post">

            <button type="submit" class="btn btn-success">
                Approve Application
            </button>
        </form>

        <form asp-controller="Admin"
              asp-action="RejectApplication"
              asp-route-id="@Model.Id"
              method="post">

            <button type="submit" class="btn btn-danger">
                Reject Application
            </button>
        </form>
    </div>
}
else
{
    <div class="alert alert-secondary">
        This application has already been reviewed.
    </div>
}
</div>
