@model List<Staybnb.Models.Booking>
@using System.Globalization

@{
ViewData["Title"] = "Manage Bookings";


var bookings = Model ?? new List<Staybnb.Models.Booking>();
var zar = new CultureInfo("en-ZA");

var pendingBookings = bookings.Count(b => b.Status == "Pending");
var approvedBookings = bookings.Count(b => b.Status == "Approved");
var rejectedBookings = bookings.Count(b => b.Status == "Rejected");
var cancelledBookings = bookings.Count(b => b.Status == "Cancelled");


}

<div class="host-bookings-page">

<section class="host-bookings-hero">
    <div class="host-bookings-hero-content">
        <span class="host-bookings-eyebrow">HOST MANAGEMENT</span>
        <h1>Manage Bookings</h1>
        <p>Keep track of reservations, review guest requests, and manage upcoming stays in one place.</p>

        <div class="host-bookings-hero-meta">
            <span class="host-bookings-meta-item">
                <span class="host-bookings-meta-dot"></span>
                @pendingBookings pending @(pendingBookings == 1 ? "request" : "requests")
            </span>
            <span class="host-bookings-meta-divider"></span>
            <span>@bookings.Count total @(bookings.Count == 1 ? "booking" : "bookings")</span>
        </div>
    </div>

    <a asp-controller="Host"
       asp-action="Index"
       class="host-bookings-back-btn">
        <span aria-hidden="true">←</span>
        Back to Dashboard
    </a>
</section>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info alert-dismissible fade show host-bookings-alert" role="alert">
        @TempData["Message"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close"></button>
    </div>
}

<section class="host-bookings-stats">

    <article class="host-booking-stat">
        <div class="host-booking-stat-top">
            <span class="host-booking-stat-label">Pending Requests</span>
            <span class="host-booking-stat-icon pending-icon">◷</span>
        </div>
        <strong>@pendingBookings</strong>
        <p>Awaiting your decision</p>
    </article>

    <article class="host-booking-stat">
        <div class="host-booking-stat-top">
            <span class="host-booking-stat-label">Approved</span>
            <span class="host-booking-stat-icon approved-icon">✓</span>
        </div>
        <strong>@approvedBookings</strong>
        <p>Confirmed reservations</p>
    </article>

    <article class="host-booking-stat">
        <div class="host-booking-stat-top">
            <span class="host-booking-stat-label">Rejected</span>
            <span class="host-booking-stat-icon rejected-icon">×</span>
        </div>
        <strong>@rejectedBookings</strong>
        <p>Requests not accepted</p>
    </article>

    <article class="host-booking-stat">
        <div class="host-booking-stat-top">
            <span class="host-booking-stat-label">Cancelled</span>
            <span class="host-booking-stat-icon cancelled-icon">−</span>
        </div>
        <strong>@cancelledBookings</strong>
        <p>Cancelled reservations</p>
    </article>

</section>

<section class="host-bookings-list-section">

    <div class="host-bookings-section-heading">
        <div>
            <span class="host-bookings-eyebrow">RESERVATION OVERVIEW</span>
            <h2>Guest Reservations</h2>
            <p>Review booking details and respond to pending requests.</p>
        </div>

        <span class="host-bookings-count">
            @bookings.Count @(bookings.Count == 1 ? "reservation" : "reservations")
        </span>
    </div>

    @if (!bookings.Any())
    {
        <div class="host-bookings-empty">
            <div class="host-bookings-empty-icon">⌂</div>
            <h3>No bookings yet</h3>
            <p>When guests request to stay at one of your properties, their reservations will appear here.</p>
            <a asp-controller="Host"
               asp-action="Index"
               class="btn host-bookings-empty-btn">
                Return to Dashboard
            </a>
        </div>
    }
    else
    {
        <div class="host-bookings-table-card">
            <div class="host-bookings-table-scroll">
                <table class="host-bookings-table">
                    <thead>
                        <tr>
                            <th>Property & Guest</th>
                            <th>Stay Dates</th>
                            <th>Guests</th>
                            <th>Total Price</th>
                            <th>Status</th>
                            <th class="host-bookings-actions-heading">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var booking in bookings)
                        {
                            <tr>
                                <td>
                                    <div class="host-booking-property">
                                        <div class="host-booking-property-icon">⌂</div>
                                        <div class="host-booking-property-info">
                                            <strong>@(booking.Property?.Title ?? "Unknown property")</strong>
                                            <span>@(booking.Property?.City ?? "Location unavailable")</span>
                                            <small>Guest: @(booking.Guest?.FullName ?? "Unknown guest")</small>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <div class="host-booking-dates">
                                        <div>
                                            <span>CHECK-IN</span>
                                            <strong>@booking.CheckInDate.ToString("dd MMM yyyy")</strong>
                                        </div>
                                        <div>
                                            <span>CHECK-OUT</span>
                                            <strong>@booking.CheckOutDate.ToString("dd MMM yyyy")</strong>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="host-booking-guests">
                                        <span aria-hidden="true">♙</span>
                                        @booking.NumberOfGuests
                                        @(booking.NumberOfGuests == 1 ? "guest" : "guests")
                                    </span>
                                </td>

                                <td>
                                    <div class="host-booking-total">
                                        @booking.TotalPrice.ToString("C", zar)
                                    </div>
                                </td>

                                <td>
                                    @switch (booking.Status)
                                    {
                                        case "Pending":
                                            <span class="host-booking-status status-pending">
                                                <span></span> Pending
                                            </span>
                                            break;

                                        case "Approved":
                                            <span class="host-booking-status status-approved">
                                                <span></span> Approved
                                            </span>
                                            break;

                                        case "Rejected":
                                            <span class="host-booking-status status-rejected">
                                                <span></span> Rejected
                                            </span>
                                            break;

                                        case "Cancelled":
                                            <span class="host-booking-status status-cancelled">
                                                <span></span> Cancelled
                                            </span>
                                            break;

                                        default:
                                            <span class="host-booking-status status-cancelled">
                                                <span></span> @booking.Status
                                            </span>
                                            break;
                                    }
                                </td>

                                <td>
                                    @if (booking.Status == "Pending")
                                    {
                                        <div class="host-booking-action-buttons">

                                            <form asp-controller="Host"
                                                  asp-action="ApproveBooking"
                                                  asp-route-id="@booking.Id"
                                                  method="post">
                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="host-booking-approve-btn">
                                                    Approve
                                                </button>
                                            </form>

                                            <form asp-controller="Host"
                                                  asp-action="RejectBooking"
                                                  asp-route-id="@booking.Id"
                                                  method="post">
                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="host-booking-reject-btn">
                                                    Reject
                                                </button>
                                            </form>

                                        </div>
                                    }
                                    else
                                    {
                                        <span class="host-booking-no-action">No action required</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="host-bookings-table-footer">
                <span>Showing @bookings.Count @(bookings.Count == 1 ? "reservation" : "reservations")</span>
                <span>Staybnb Host Management</span>
            </div>
        </div>
    }

</section>

</div>
