@model IEnumerable<Staybnb.Models.ActivityLog>

@{
ViewData["Title"] = "Activity Logs";
}

<div class="container py-4">

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Activity Logs</h2>
        <p class="text-muted mb-0">
            Monitor important actions performed throughout Staybnb.
        </p>
    </div>

    <a asp-controller="Admin"
       asp-action="Index"
       class="btn btn-outline-secondary">
        Back to Dashboard
    </a>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">

        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Date and Time</th>
                            <th>Action</th>
                            <th>Details</th>
                            <th>User ID</th>
                            <th>IP Address</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var activity in Model)
                        {
                            <tr>
                                <td class="text-nowrap">
                                    @activity.Timestamp.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                                </td>

                                <td>
                                    <span class="badge bg-primary">
                                        @activity.Action
                                    </span>
                                </td>

                                <td>
                                    @activity.Details
                                </td>

                                <td>
                                    <small>
                                        @(string.IsNullOrWhiteSpace(activity.UserId)
                                            ? "System / Unknown"
                                            : activity.UserId)
                                    </small>
                                </td>

                                <td>
                                    <small>
                                        @(activity.IPAddress ?? "Unavailable")
                                    </small>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <h5>No activity recorded yet</h5>
                <p class="text-muted">
                    Activity records will appear here when users
                    perform tracked actions.
                </p>
            </div>
        }

    </div>
</div>

<p class="text-muted small mt-3">
    Showing up to the latest 200 recorded activities.
</p>

</div>
