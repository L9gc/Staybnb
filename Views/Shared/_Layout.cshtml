<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>@ViewData["Title"] - Staybnb</title>

<script type="importmap"></script>

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/Staybnb.styles.css" asp-append-version="true" />


</head>

<body>
    <header class="staybnb-header">
        <nav class="navbar navbar-expand-lg staybnb-navbar">
            <div class="container">

            <!-- Brand -->
            <a class="navbar-brand staybnb-brand"
               asp-controller="Home"
               asp-action="Index"
               aria-label="Staybnb home">

                <span class="staybnb-brand-icon">S</span>
                <span>Staybnb<span class="staybnb-brand-dot">.</span></span>
            </a>

            <!-- Mobile navigation toggle -->
            <button class="navbar-toggler staybnb-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#staybnbNavbar"
                    aria-controls="staybnbNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="staybnbNavbar">

                <!-- Main navigation -->
                <ul class="navbar-nav staybnb-nav me-auto">

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">
                            Home
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Properties"
                           asp-action="Index">
                            Explore Properties
                        </a>
                    </li>

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole("Guest"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Bookings"
                                   asp-action="MyBookings">
                                    My Bookings
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="HostApplications"
                                   asp-action="Create">
                                    Become a Host
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Host"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Host"
                                   asp-action="Index">
                                    Host Dashboard
                                </a>
                            </li>
                        }

                        @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Admin"
                                   asp-action="Index">
                                    Admin Dashboard
                                </a>
                            </li>
                        }
                    }
                </ul>

                <!-- Account navigation -->
                <ul class="navbar-nav staybnb-account-nav align-items-lg-center">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link staybnb-utility-link"
                               asp-controller="Messages"
                               asp-action="Index">
                                <span class="staybnb-nav-icon" aria-hidden="true">✉</span>
                                Messages
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link staybnb-utility-link"
                               asp-controller="Notifications"
                               asp-action="Index">
                                <span class="staybnb-nav-icon" aria-hidden="true">♧</span>
                                Notifications
                            </a>
                        </li>

                        <li class="nav-item staybnb-user-item">
                            <span class="staybnb-user-greeting">
                                <span class="staybnb-user-avatar" aria-hidden="true">
                                    @{
                                        var displayName = User.Identity.Name ?? "User";
                                        var initial = displayName.Length > 0
                                            ? displayName.Substring(0, 1).ToUpperInvariant()
                                            : "U";
                                    }
                                    @initial
                                </span>

                                <span class="staybnb-user-text">
                                    Welcome,<br />
                                    <strong>@User.Identity.Name</strong>
                                </span>
                            </span>
                        </li>

                        <li class="nav-item">
                            <form asp-controller="Account"
                                  asp-action="Logout"
                                  method="post"
                                  class="staybnb-logout-form">

                                <button type="submit"
                                        class="btn staybnb-logout-btn">
                                    Sign Out
                                </button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link staybnb-signin-link"
                               asp-controller="Account"
                               asp-action="Login">
                                Sign In
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="btn staybnb-register-btn"
                               asp-controller="Account"
                               asp-action="Register">
                                Get Started
                                <span aria-hidden="true">→</span>
                            </a>
                        </li>
                    }
                </ul>

            </div>
        </div>
    </nav>
</header>

<!-- Page content -->
<main role="main" class="staybnb-main">
    @RenderBody()
</main>

<!-- Footer -->
<footer class="staybnb-footer">
    <div class="container">

        <div class="staybnb-footer-main">

            <div class="staybnb-footer-brand-section">
                <a asp-controller="Home"
                   asp-action="Index"
                   class="footer-brand">

                    <span class="staybnb-footer-icon">S</span>
                    <span>Staybnb<span class="staybnb-brand-dot">.</span></span>
                </a>

                <p class="staybnb-footer-description">
                    Find your next stay. Discover places worth exploring
                    and make yourself at home.
                </p>
            </div>

            <div class="staybnb-footer-links">
                <h2>Explore</h2>

                <a asp-controller="Home"
                   asp-action="Index">
                    Home
                </a>

                <a asp-controller="Properties"
                   asp-action="Index">
                    Explore Properties
                </a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole("Guest"))
                    {
                        <a asp-controller="Bookings"
                           asp-action="MyBookings">
                            My Bookings
                        </a>
                    }

                    @if (User.IsInRole("Host"))
                    {
                        <a asp-controller="Host"
                           asp-action="Index">
                            Host Dashboard
                        </a>
                    }
                }
            </div>

            <div class="staybnb-footer-links">
                <h2>Your Account</h2>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Messages"
                       asp-action="Index">
                        Messages
                    </a>

                    <a asp-controller="Notifications"
                       asp-action="Index">
                        Notifications
                    </a>
                }
                else
                {
                    <a asp-controller="Account"
                       asp-action="Login">
                        Sign In
                    </a>

                    <a asp-controller="Account"
                       asp-action="Register">
                        Create Account
                    </a>
                }

                <a asp-controller="Home"
                   asp-action="Privacy">
                    Privacy Policy
                </a>
            </div>

        </div>

        <div class="staybnb-footer-bottom">
            <p>
                &copy; @DateTime.Now.Year Staybnb. All rights reserved.
            </p>

            <span>Made for your next adventure.</span>
        </div>

    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
