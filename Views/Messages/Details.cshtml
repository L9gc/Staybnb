@model Staybnb.Models.Message

@{
    ViewData["Title"] = "Message Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>Message Details</h1>

                <a asp-action="Index" class="btn btn-outline-secondary">
                    Back to Inbox
                </a>
            </div>

            <div class="card shadow-sm">
                <div class="card-header">
                    <h4 class="mb-0">@Model.Subject</h4>
                </div>

                <div class="card-body">

                    <div class="mb-3">
                        <strong>From:</strong>
                        @(Model.Sender?.FullName
                            ?? Model.Sender?.Email
                            ?? "Unknown user")
                    </div>

                    <div class="mb-3">
                        <strong>To:</strong>
                        @(Model.Receiver?.FullName
                            ?? Model.Receiver?.Email
                            ?? "Unknown user")
                    </div>

                    <div class="mb-4">
                        <strong>Date:</strong>
                        @Model.SentAt.ToLocalTime().ToString("dd MMMM yyyy, HH:mm")
                    </div>

                    <hr />

                    <div class="message-content">
                        <p style="white-space: pre-wrap;">@Model.Content</p>
                    </div>

                </div>

                <div class="card-footer d-flex justify-content-between">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Inbox
                    </a>

                    <a asp-action="Reply"
                       asp-route-id="@Model.Id"
                       class="btn btn-primary">
                        Reply
                    </a>

                </div>
            </div>

        </div>
    </div>
</div>