@model Staybnb.ViewModels.CheckInProcessViewModel

@{
ViewData["Title"] = "Check-in Settings";
}

<div class="container py-4">
    <div class="mb-4">
        <a asp-controller="Host"
           asp-action="Index"
           class="btn btn-outline-secondary btn-sm mb-3">
            &larr; Back to Dashboard
        </a>

    <p class="text-uppercase text-muted small fw-semibold mb-2">
        Host Management
    </p>

    <h1 class="fw-bold">Check-in Settings</h1>

    <p class="text-muted">
        Configure check-in information for
        <strong>@Model.PropertyTitle</strong>.
    </p>
</div>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">
        @TempData["Message"]
    </div>
}

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
        <form asp-controller="Host"
              asp-action="CheckInSettings"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="PropertyId" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-4">
                <label asp-for="Rules"
                       class="form-label fw-semibold"></label>

                <textarea asp-for="Rules"
                          class="form-control"
                          rows="6"
                          placeholder="Explain how guests should check in, collect keys, and follow property rules."></textarea>

                <span asp-validation-for="Rules"
                      class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="RequiredDocuments"
                       class="form-label fw-semibold"></label>

                <textarea asp-for="RequiredDocuments"
                          class="form-control"
                          rows="4"
                          placeholder="List any documents guests must provide and explain how to submit them securely."></textarea>

                <span asp-validation-for="RequiredDocuments"
                      class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-dark">
                Save Check-in Settings
            </button>
        </form>
    </div>
</div>

</div>
