@model Staybnb.Models.Property

@{
ViewData["Title"] = Model.Title;
var zar = System.Globalization.CultureInfo.GetCultureInfo("en-ZA");
var images = Model.Images.ToList();
var mainImage = images.FirstOrDefault();
}

<div class="property-details-page">

<!-- Breadcrumb -->
<div class="property-details-topbar">
    <a asp-controller="Properties"
       asp-action="Index"
       class="property-back-link">
        <span aria-hidden="true">&larr;</span> Back to properties
    </a>

    <span class="property-details-brand">STAYBNB <span>.</span></span>
</div>

<!-- Property Heading -->
<section class="property-details-heading">
    <div>
        <span class="section-eyebrow">@Model.PropertyType · @Model.City</span>
        <h1>@Model.Title</h1>

        <p class="property-address">
            <span aria-hidden="true">&#9906;</span>
            @Model.Address, @Model.City
        </p>
    </div>

    <div class="property-heading-price">
        <strong>@Model.PricePerNight.ToString("C", zar)</strong>
        <span>per night</span>
    </div>
</section>

<!-- Image Gallery -->
<section class="property-gallery" aria-label="Property photos">

    @if (mainImage != null)
    {
        <div class="property-gallery-main">
            <img src="@mainImage.ImagePath"
                 alt="Main photo of @Model.Title" />
            <span class="property-gallery-label">YOUR NEXT STAY</span>
        </div>

        <div class="property-gallery-side">
            @foreach (var image in images.Skip(1).Take(4))
            {
                <div class="property-gallery-thumbnail">
                    <img src="@image.ImagePath"
                         alt="Photo of @Model.Title"
                         loading="lazy" />
                </div>
            }

            @if (images.Count == 1)
            {
                <div class="property-gallery-placeholder">
                    <span aria-hidden="true">⌂</span>
                    <p>Your next adventure starts here.</p>
                </div>
            }
            else if (images.Count == 2)
            {
                <div class="property-gallery-placeholder">
                    <span aria-hidden="true">✳</span>
                    <p>Make yourself at home.</p>
                </div>
            }
        </div>
    }
    else
    {
        <div class="property-gallery-empty">
            <span aria-hidden="true">⌂</span>
            <h2>Your next stay awaits.</h2>
            <p>Photos for this property haven't been added yet.</p>
        </div>
    }

</section>

<!-- Main Content -->
<div class="property-details-layout">

    <main class="property-details-main">

        <!-- About -->
        <section class="property-content-section">
            <span class="section-eyebrow">GET TO KNOW THE PLACE</span>
            <h2>About this property</h2>

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <p class="property-description">@Model.Description</p>
            }
            else
            {
                <p class="property-description">
                    More information about this property will be available soon.
                </p>
            }
        </section>

        <div class="property-details-divider"></div>

        <!-- Information -->
        <section class="property-content-section">
            <span class="section-eyebrow">THE ESSENTIALS</span>
            <h2>Property information</h2>

            <div class="property-info-grid">

                <div class="property-info-item">
                    <span class="property-info-icon" aria-hidden="true">⌂</span>
                    <div>
                        <span>Property type</span>
                        <strong>@Model.PropertyType</strong>
                    </div>
                </div>

                <div class="property-info-item">
                    <span class="property-info-icon" aria-hidden="true">⌖</span>
                    <div>
                        <span>Destination</span>
                        <strong>@Model.City</strong>
                    </div>
                </div>

                <div class="property-info-item property-info-address">
                    <span class="property-info-icon" aria-hidden="true">⌑</span>
                    <div>
                        <span>Address</span>
                        <strong>@Model.Address</strong>
                    </div>
                </div>

            </div>
        </section>

        <div class="property-details-divider"></div>

        <!-- Fees -->
        <section class="property-content-section">
            <span class="section-eyebrow">CLEAR PRICING</span>
            <h2>Understand the cost</h2>

            <p class="property-fees-intro">
                Your final booking total depends on the length of your stay
                and the applicable fees.
            </p>

            <div class="property-fee-row">
                <span>Nightly rate</span>
                <strong>@Model.PricePerNight.ToString("C", zar)</strong>
            </div>

            <div class="property-fee-row">
                <span>Cleaning fee per booking</span>
                <strong>@Model.CleaningFee.ToString("C", zar)</strong>
            </div>

            <div class="property-fee-row">
                <span>Service fee per booking</span>
                <strong>@Model.ServiceFee.ToString("C", zar)</strong>
            </div>
        </section>

    </main>

    <!-- Booking Card -->
    <aside class="property-booking-sidebar">

        <div class="property-booking-card">

            <span class="section-eyebrow">YOUR STAY STARTS HERE</span>

            <div class="property-booking-price">
                <strong>@Model.PricePerNight.ToString("C", zar)</strong>
                <span>/ night</span>
            </div>

            <p class="property-booking-description">
                Found your next destination? Continue to arrange your stay.
            </p>

            <div class="property-booking-summary">
                <div>
                    <span>Nightly rate</span>
                    <strong>@Model.PricePerNight.ToString("C", zar)</strong>
                </div>

                <div>
                    <span>Cleaning fee</span>
                    <strong>@Model.CleaningFee.ToString("C", zar)</strong>
                </div>

                <div>
                    <span>Service fee</span>
                    <strong>@Model.ServiceFee.ToString("C", zar)</strong>
                </div>
            </div>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-controller="Bookings"
                   asp-action="Create"
                   asp-route-propertyId="@Model.Id"
                   class="property-booking-button">
                    Book this property
                    <span aria-hidden="true">&rarr;</span>
                </a>
            }
            else
            {
                <a asp-controller="Account"
                   asp-action="Login"
                   class="property-booking-button">
                    Sign in to book
                    <span aria-hidden="true">&rarr;</span>
                </a>

                <p class="property-login-hint">
                    Sign in to continue with your booking.
                </p>
            }

            <div class="property-booking-note">
                <span aria-hidden="true">✳</span>
                <p>
                    Your final total will be calculated when you select
                    your check-in and check-out dates.
                </p>
            </div>

        </div>

    </aside>

</div>

<!-- Bottom CTA -->
<section class="property-bottom-banner">
    <div>
        <span class="section-eyebrow">KEEP EXPLORING</span>
        <h2>Your next adventure is out there.</h2>
        <p>Discover another place that feels like home.</p>
    </div>

    <a asp-controller="Properties"
       asp-action="Index"
       class="property-explore-button">
        Explore more stays <span aria-hidden="true">&rarr;</span>
    </a>
</section>

</div>
