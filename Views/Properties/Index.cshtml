@model IEnumerable<Staybnb.Models.Property>

@{
ViewData["Title"] = "Explore Properties";
var propertyCount = Model.Count();
}

<div class="explore-page">

<!-- Page Header -->
<section class="explore-hero">
    <div class="explore-hero-content">
        <span class="section-eyebrow">YOUR NEXT STAY STARTS HERE</span>

        <h1>Find your place<br />in the <span>world.</span></h1>

        <p>
            From cosy homes to city apartments, discover a place
            that makes your next trip feel special.
        </p>

        <div class="explore-hero-meta">
            <span class="explore-meta-dot"></span>
            Explore stays available on Staybnb.
        </div>
    </div>

    <div class="explore-hero-art">
        <img src="https://images.unsplash.com/photo-1600210492486-724fe5c67fb0?auto=format&fit=crop&w=1000&q=85"
             alt="A welcoming modern accommodation interior" />

        <div class="explore-image-label">
            <span>MAKE YOURSELF AT HOME</span>
            <strong>Your next adventure awaits.</strong>
        </div>
    </div>
</section>

<!-- Search and Filters -->
<section class="explore-search-section">

    <div class="explore-section-heading">
        <div>
            <span class="section-eyebrow">LET'S FIND YOUR STAY</span>
            <h2>Where are you headed?</h2>
        </div>

        <span class="explore-heading-symbol" aria-hidden="true">✳</span>
    </div>

    <form asp-controller="Properties"
          asp-action="Index"
          method="get"
          class="explore-search-form">

        <div class="explore-filter-field">
            <label for="city">Destination</label>

            <input type="text"
                   id="city"
                   name="city"
                   value="@ViewBag.City"
                   placeholder="Enter a city, e.g. Durban" />
        </div>

        <div class="explore-filter-divider"></div>

        <div class="explore-filter-field">
            <label for="propertyType">Property type</label>

            <select id="propertyType" name="propertyType">
                <option value="">All property types</option>

                @if (ViewBag.PropertyTypes != null)
                {
                    foreach (var type in ViewBag.PropertyTypes)
                    {
                        <option value="@type"
                                selected="@((string?)ViewBag.PropertyType == (string)type)">
                            @type
                        </option>
                    }
                }
            </select>
        </div>

        <button type="submit" class="explore-search-button">
            <span aria-hidden="true">&#9906;</span>
            Find stays
        </button>
    </form>

    @if (!string.IsNullOrWhiteSpace((string?)ViewBag.City)
        || !string.IsNullOrWhiteSpace((string?)ViewBag.PropertyType))
    {
        <div class="explore-active-filters">
            <span>Showing filtered results</span>

            <a asp-controller="Properties"
               asp-action="Index"
               class="explore-clear-filters">
                Clear filters &times;
            </a>
        </div>
    }
</section>

<!-- Property Listings -->
<section class="explore-listings-section">

    <div class="explore-listings-heading">
        <div>
            <span class="section-eyebrow">DISCOVER STAYBNB</span>
            <h2>
                @if (propertyCount == 1)
                {
                    <text>One place to discover.</text>
                }
                else
                {
                    <text>Places worth discovering.</text>
                }
            </h2>

            <p>
                @propertyCount
                @(propertyCount == 1 ? "property" : "properties")
                @(propertyCount == 1 ? "matches" : "match") your search.
            </p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="explore-empty-state">
            <div class="explore-empty-icon" aria-hidden="true">⌂</div>

            <span class="section-eyebrow">NOT FOUND? NOT A PROBLEM.</span>

            <h3>No properties found.</h3>

            <p>
                We couldn't find any properties matching your search.
                Try another destination or choose a different property type.
            </p>

            <a asp-controller="Properties"
               asp-action="Index"
               class="btn btn-primary">
                View all properties
            </a>
        </div>
    }
    else
    {
        <div class="explore-property-grid">

            @foreach (var property in Model)
            {
                var firstImage = property.Images.FirstOrDefault();

                <article class="explore-property-card">

                    <a asp-controller="Properties"
                       asp-action="Details"
                       asp-route-id="@property.Id"
                       class="explore-property-image">

                        @if (firstImage != null)
                        {
                            <img src="@firstImage.ImagePath"
                                 alt="@property.Title"
                                 loading="lazy" />
                        }
                        else
                        {
                            <div class="explore-image-placeholder">
                                <span aria-hidden="true">⌂</span>
                                <span>Staybnb</span>
                            </div>
                        }

                        <span class="explore-property-badge">
                            Available
                        </span>
                    </a>

                    <div class="explore-property-body">

                        <div class="explore-property-location">
                            <span aria-hidden="true">⌖</span>
                            @property.City
                            <span class="location-separator">·</span>
                            @property.PropertyType
                        </div>

                        <h3>
                            <a asp-controller="Properties"
                               asp-action="Details"
                               asp-route-id="@property.Id">
                                @property.Title
                            </a>
                        </h3>

                        <p class="explore-property-description">
                            @if (!string.IsNullOrWhiteSpace(property.Description))
                            {
                                @(property.Description.Length > 105
                                    ? property.Description[..105] + "..."
                                    : property.Description)
                            }
                            else
                            {
                                <text>Discover this property on Staybnb.</text>
                            }
                        </p>

                        <div class="explore-property-footer">

                            <div class="explore-property-price">
                                <strong>
                                    @property.PricePerNight.ToString(
                                        "C",
                                        System.Globalization.CultureInfo.GetCultureInfo("en-ZA"))
                                </strong>

                                <span>per night</span>
                            </div>

                            <a asp-controller="Properties"
                               asp-action="Details"
                               asp-route-id="@property.Id"
                               class="explore-view-button">
                                View stay
                                <span aria-hidden="true">&rarr;</span>
                            </a>

                        </div>
                    </div>
                </article>
            }

        </div>
    }

</section>

<!-- Host Call to Action -->
<section class="explore-host-banner">
    <div>
        <span class="section-eyebrow">HAVE A PLACE TO SHARE?</span>

        <h2>Make room for someone's next adventure.</h2>

        <p>
            Share your space with travellers and start your journey as a
            Staybnb host.
        </p>
    </div>

    <a asp-controller="HostApplications"
       asp-action="Create"
       class="btn btn-dark btn-lg">
        Become a host <span aria-hidden="true">&rarr;</span>
    </a>
</section>

</div>
