@{
ViewData["Title"] = "Compose Message";

var users = ViewBag.Users;
string? selectedReceiver = ViewBag.ReceiverId;
string? subject = ViewBag.Subject;
string? content = ViewBag.Content;


}

<div class="messages-page compose-page">
    <div class="messages-header">
        <div>
            <span class="messages-eyebrow">STAYBNB MESSAGES</span>
            <h1>Compose Message</h1>
            <p>Start a conversation with another member of the Staybnb community.</p>
        </div>
    <a asp-action="Index" class="compose-back-btn">
        <span aria-hidden="true">&larr;</span>
        Back to Inbox
    </a>
</div>

<div class="compose-layout">
    <div class="compose-card">
        <div class="compose-card-header">
            <div class="compose-card-icon">
                <span aria-hidden="true">&#9993;</span>
            </div>

            <div>
                <h2>New Message</h2>
                <p>Complete the details below to send your message.</p>
            </div>
        </div>

        <form asp-controller="Messages"
              asp-action="Create"
              method="post"
              class="compose-form">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="alert alert-danger"
                 role="alert"></div>

            <div class="compose-field">
                <label for="receiverId">
                    Recipient
                    <span class="compose-required">*</span>
                </label>

                <select id="receiverId"
                        name="receiverId"
                        class="form-select"
                        required>

                    <option value="">Choose who to message</option>

                    @if (users != null)
                    {
                        foreach (var user in users)
                        {
                            <option value="@user.Id"
                                    selected="@(selectedReceiver == user.Id)">
                                @(string.IsNullOrWhiteSpace((string?)user.FullName)
                                    ? user.Email
                                    : user.FullName)
                            </option>
                        }
                    }
                </select>

                <span class="text-danger">
                    @Html.ValidationMessage("receiverId")
                </span>
            </div>

            <div class="compose-field">
                <label for="subject">
                    Subject
                    <span class="compose-required">*</span>
                </label>

                <input type="text"
                       id="subject"
                       name="subject"
                       class="form-control"
                       maxlength="150"
                       value="@subject"
                       placeholder="What would you like to discuss?"
                       required />

                <span class="text-danger">
                    @Html.ValidationMessage("subject")
                </span>
            </div>

            <div class="compose-field">
                <div class="compose-message-label">
                    <label for="content">
                        Your Message
                        <span class="compose-required">*</span>
                    </label>

                    <span class="compose-character-hint">
                        Maximum 5,000 characters
                    </span>
                </div>

                <textarea id="content"
                          name="content"
                          class="form-control compose-textarea"
                          rows="9"
                          maxlength="5000"
                          placeholder="Write your message here..."
                          required>@content</textarea>

                <div class="compose-field-bottom">
                    <span class="text-danger">
                        @Html.ValidationMessage("content")
                    </span>

                    <span id="composeCharCount" class="compose-char-count">
                        0 / 5000
                    </span>
                </div>
            </div>

            <div class="compose-form-footer">
                <a asp-action="Index" class="compose-cancel-btn">
                    Cancel
                </a>

                <button type="submit" class="compose-send-btn">
                    <span>Send Message</span>
                    <span aria-hidden="true">&rarr;</span>
                </button>
            </div>
        </form>
    </div>

    <aside class="compose-sidebar">
        <div class="compose-tip-icon">
            <span aria-hidden="true">&#128161;</span>
        </div>

        <h3>A quick tip</h3>

        <p>
            Keep your message clear and friendly. Whether you're
            contacting a host or another member, a helpful subject
            makes it easier to follow the conversation.
        </p>

        <div class="compose-sidebar-divider"></div>

        <div class="compose-sidebar-note">
            <span class="compose-note-dot"></span>
            <span>Your message will be available in your Sent Messages folder.</span>
        </div>
    </aside>
</div>

<div class="messages-footer-note">
    <span>Staybnb</span>
    <span>Your conversations, all in one place.</span>
</div>


</div>

@section Scripts { <partial name="_ValidationScriptsPartial" />


<script>
    document.addEventListener("DOMContentLoaded", function () {
        const messageBox = document.getElementById("content");
        const counter = document.getElementById("composeCharCount");

        if (!messageBox || !counter) {
            return;
        }

        function updateCharacterCount() {
            counter.textContent = messageBox.value.length + " / 5000";
        }

        messageBox.addEventListener("input", updateCharacterCount);
        updateCharacterCount();
    });
</script>

}
