@model Staybnb.ViewModels.LoginViewModel

@{
ViewData["Title"] = "Sign In";
}

<div class="auth-page">
    <div class="auth-container">

    <!-- Left: Welcome panel -->
    <div class="auth-welcome">
        <div class="auth-brand">
            <span class="auth-brand-icon">S</span>
            <span>Staybnb</span>
        </div>

        <div class="auth-welcome-content">
            <span class="auth-eyebrow">YOUR NEXT STAY STARTS HERE</span>

            <h1>Welcome back.</h1>

            <p>
                Find your next getaway, manage your bookings,
                and pick up right where you left off.
            </p>

            <div class="auth-feature">
                <span class="auth-feature-icon">✓</span>
                <span>Explore places worth staying in</span>
            </div>

            <div class="auth-feature">
                <span class="auth-feature-icon">✓</span>
                <span>Keep your bookings organised</span>
            </div>

            <div class="auth-feature">
                <span class="auth-feature-icon">✓</span>
                <span>Manage your Staybnb account</span>
            </div>
        </div>

        <div class="auth-welcome-footer">
            Find a place that feels like yours.
        </div>
    </div>

    <!-- Right: Login form -->
    <div class="auth-form-panel">
        <div class="auth-form-content">

            <div class="auth-mobile-brand">
                <span class="auth-brand-icon">S</span>
                <span>Staybnb</span>
            </div>

            <div class="auth-heading">
                <span class="auth-eyebrow">GOOD TO HAVE YOU BACK</span>
                <h2>Sign in to your account</h2>
                <p>Enter your details to continue.</p>
            </div>

            <form asp-controller="Account"
                  asp-action="Login"
                  asp-route-returnUrl="@ViewData["ReturnUrl"]"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="auth-validation-summary">
                </div>

                <div class="auth-field">
                    <label asp-for="Email" class="form-label">
                        Email address
                    </label>

                    <input asp-for="Email"
                           class="form-control auth-input"
                           placeholder="name@example.com"
                           autocomplete="username"
                           autofocus />

                    <span asp-validation-for="Email"
                          class="text-danger auth-field-error"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Password" class="form-label">
                        Password
                    </label>

                    <input asp-for="Password"
                           class="form-control auth-input"
                           placeholder="Enter your password"
                           autocomplete="current-password" />

                    <span asp-validation-for="Password"
                          class="text-danger auth-field-error"></span>
                </div>

                <div class="auth-form-options">
                    <div class="form-check">
                        <input asp-for="RememberMe"
                               class="form-check-input" />

                        <label asp-for="RememberMe"
                               class="form-check-label">
                            Remember me
                        </label>
                    </div>
                </div>

                <button type="submit" class="auth-submit-btn">
                    Sign In
                    <span aria-hidden="true">→</span>
                </button>

            </form>

            <div class="auth-divider">
                <span>NEW TO STAYBNB?</span>
            </div>

            <a asp-controller="Account"
               asp-action="Register"
               class="auth-register-btn">
                Create an account
            </a>

            <p class="auth-terms">
                By signing in, you can access your bookings and
                manage your Staybnb account.
            </p>

        </div>
    </div>

</div>

</div>

@section Scripts { <partial name="_ValidationScriptsPartial" />
}
