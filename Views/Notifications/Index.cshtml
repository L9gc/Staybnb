@model List<Staybnb.Models.Notification>

@{
ViewData["Title"] = "Notifications";


var unreadCount = Model.Count(n => !n.IsRead);


}

<div class="notifications-page">

<div class="notifications-header">
    <div>
        <span class="notifications-eyebrow">STAYBNB UPDATES</span>
        <h1>Notifications</h1>
        <p>Stay informed about your bookings, messages, and account activity.</p>
    </div>

    @if (unreadCount > 0)
    {
        <form asp-action="MarkAllAsRead" method="post">
            @Html.AntiForgeryToken()

            <button type="submit" class="notifications-mark-all">
                <span aria-hidden="true">&#10003;</span>
                Mark All as Read
            </button>
        </form>
    }
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="notifications-alert">
        <span class="notifications-alert-icon">&#10003;</span>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}

<div class="notifications-overview">
    <div class="notification-stat-card">
        <div class="notification-stat-icon notification-stat-unread">
            &#9679;
        </div>
        <div>
            <span class="notification-stat-label">Unread</span>
            <strong>@unreadCount</strong>
        </div>
    </div>

    <div class="notification-stat-card">
        <div class="notification-stat-icon notification-stat-total">
            &#128276;
        </div>
        <div>
            <span class="notification-stat-label">All Notifications</span>
            <strong>@Model.Count</strong>
        </div>
    </div>
</div>

<div class="notifications-section-heading">
    <div>
        <h2>Your Activity</h2>
        <p>Updates and important information from Staybnb.</p>
    </div>

    @if (unreadCount > 0)
    {
        <span class="notifications-unread-label">
            @unreadCount unread
        </span>
    }
</div>

@if (!Model.Any())
{
    <div class="notifications-empty">
        <div class="notifications-empty-icon">
            <span aria-hidden="true">&#128276;</span>
        </div>

        <h3>You're all caught up!</h3>

        <p>
            You don't have any notifications yet.
            When something happens on Staybnb, your updates will appear here.
        </p>

        <a asp-controller="Home"
           asp-action="Index"
           class="notifications-home-btn">
            Back to Home
        </a>
    </div>
}
else
{
    <div class="notifications-list">

        @foreach (var notification in Model)
        {
            <div class="notification-item @(notification.IsRead ? "" : "notification-unread")">

                <div class="notification-item-icon @(notification.IsRead ? "notification-icon-read" : "notification-icon-new")">
                    @if (!notification.IsRead)
                    {
                        <span aria-hidden="true">&#128276;</span>
                    }
                    else
                    {
                        <span aria-hidden="true">&#10003;</span>
                    }
                </div>

                <div class="notification-item-content">

                    <div class="notification-item-heading">
                        <h3>@notification.Title</h3>

                        @if (!notification.IsRead)
                        {
                            <span class="notification-new-badge">NEW</span>
                        }
                    </div>

                    <p class="notification-message">
                        @notification.MessageText
                    </p>

                    <div class="notification-item-meta">
                        <span class="notification-time-icon" aria-hidden="true">&#128337;</span>
                        <span>
                            @notification.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                        </span>
                    </div>
                </div>

                <div class="notification-item-actions">

                    @if (!string.IsNullOrWhiteSpace(notification.LinkUrl))
                    {
                        <a asp-action="Open"
                           asp-route-id="@notification.Id"
                           class="notification-view-btn">
                            View
                            <span aria-hidden="true">&rarr;</span>
                        </a>
                    }
                    else if (!notification.IsRead)
                    {
                        <form asp-action="MarkAsRead"
                              asp-route-id="@notification.Id"
                              method="post">

                            @Html.AntiForgeryToken()

                            <button type="submit"
                                    class="notification-read-btn">
                                Mark as Read
                            </button>
                        </form>
                    }
                    else
                    {
                        <span class="notification-read-status">
                            <span aria-hidden="true">&#10003;</span>
                            Read
                        </span>
                    }

                </div>

            </div>
        }

    </div>
}

<div class="notifications-footer-note">
    <span>Staybnb</span>
    <span>Keeping you up to date, every step of the way.</span>
</div>

</div>
