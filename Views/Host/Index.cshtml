@model List<Staybnb.Models.Property>
@using System.Globalization

@{
ViewData["Title"] = "Host Dashboard";
var zar = new CultureInfo("en-ZA");
var totalProperties = Model.Count;
var activeProperties = Model.Count(p => p.IsActive);
var inactiveProperties = totalProperties - activeProperties;
}

<div class="host-dashboard">

<section class="host-dashboard-hero">
    <div class="host-dashboard-hero-content">
        <span class="host-dashboard-eyebrow">YOUR HOSTING SPACE</span>
        <h1>Host Dashboard</h1>
        <p>Manage your properties, monitor availability, and prepare for your next guests.</p>

        <div class="host-dashboard-hero-actions">
            <a asp-controller="Host" asp-action="Bookings" class="btn host-btn-primary">
                Manage Bookings
            </a>

            <a asp-controller="Host" asp-action="Documents" class="btn host-btn-secondary">
                Review Guest Documents
            </a>
        </div>
    </div>

    <div class="host-dashboard-hero-decoration" aria-hidden="true">
        <div class="host-dashboard-decoration-circle"></div>
        <div class="host-dashboard-decoration-card">
            <span class="host-decoration-icon">⌂</span>
            <span>Your properties</span>
            <strong>@totalProperties</strong>
            <small>Listings managed</small>
        </div>
    </div>
</section>

@if (TempData["Message"] != null)
{
    <div class="alert alert-info alert-dismissible fade show host-dashboard-alert" role="alert">
        @TempData["Message"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<section class="host-dashboard-stats">
    <div class="host-stat-card">
        <div class="host-stat-icon">⌂</div>
        <div>
            <span class="host-stat-label">Total Properties</span>
            <strong>@totalProperties</strong>
            <small>All your listings</small>
        </div>
    </div>

    <div class="host-stat-card">
        <div class="host-stat-icon host-stat-icon-active">✓</div>
        <div>
            <span class="host-stat-label">Active Listings</span>
            <strong>@activeProperties</strong>
            <small>Currently available to browse</small>
        </div>
    </div>

    <div class="host-stat-card">
        <div class="host-stat-icon host-stat-icon-inactive">Ⅱ</div>
        <div>
            <span class="host-stat-label">Inactive Listings</span>
            <strong>@inactiveProperties</strong>
            <small>Temporarily unavailable</small>
        </div>
    </div>
</section>

<section class="host-listings-section">
    <div class="host-section-heading">
        <div>
            <span class="host-dashboard-eyebrow">PROPERTY MANAGEMENT</span>
            <h2>My Properties</h2>
            <p>Review your listings and manage their availability.</p>
        </div>

        <span class="host-listing-count">
            @totalProperties @(totalProperties == 1 ? "property" : "properties")
        </span>
    </div>

    @if (!Model.Any())
    {
        <div class="host-empty-state">
            <div class="host-empty-icon">⌂</div>
            <h3>No properties yet</h3>
            <p>You don't have any property listings associated with your account yet.</p>
            <p class="host-empty-hint">Once a host application is approved, your property will appear here.</p>
        </div>
    }
    else
    {
        <div class="host-property-grid">
            @foreach (var property in Model)
            {
                var firstImage = property.Images?.FirstOrDefault();

                <article class="host-property-card">

                    <div class="host-property-image-wrap">
                        @if (firstImage != null && !string.IsNullOrWhiteSpace(firstImage.ImagePath))
                        {
                            <img src="@firstImage.ImagePath"
                                 class="host-property-image"
                                 alt="@property.Title" />
                        }
                        else
                        {
                            <div class="host-property-no-image">
                                <span>⌂</span>
                                <p>No image available</p>
                            </div>
                        }

                        <span class="host-property-status @(property.IsActive ? "is-active" : "is-inactive")">
                            <span class="host-status-dot"></span>
                            @(property.IsActive ? "Active" : "Inactive")
                        </span>
                    </div>

                    <div class="host-property-content">
                        <div class="host-property-heading">
                            <div>
                                <p class="host-property-location">⌖ @property.City</p>
                                <h3>@property.Title</h3>
                            </div>
                        </div>

                        <p class="host-property-description">
                            @property.Description
                        </p>

                        <div class="host-property-meta">
                            <span>@property.PropertyType</span>
                        </div>

                        <div class="host-property-price">
                            <strong>@property.PricePerNight.ToString("C", zar)</strong>
                            <span>/ night</span>
                        </div>

                        <div class="host-property-actions">
                            <a asp-controller="Properties"
                               asp-action="Details"
                               asp-route-id="@property.Id"
                               class="btn host-property-view-btn">
                                View Property
                            </a>

                            <a asp-controller="Host"
                               asp-action="CheckInSettings"
                               asp-route-id="@property.Id"
                               class="btn host-property-settings-btn">
                                Check-in Settings
                            </a>
                        </div>

                        <form asp-controller="Host"
                              asp-action="ToggleListing"
                              asp-route-id="@property.Id"
                              method="post"
                              class="host-property-toggle-form">

                            @Html.AntiForgeryToken()

                            @if (property.IsActive)
                            {
                                <button type="submit" class="btn host-property-toggle-btn deactivate">
                                    Deactivate Listing
                                </button>
                            }
                            else
                            {
                                <button type="submit" class="btn host-property-toggle-btn activate">
                                    Activate Listing
                                </button>
                            }
                        </form>
                    </div>
                </article>
            }
        </div>
    }
</section>

<section class="host-dashboard-help">
    <div>
        <span class="host-dashboard-eyebrow">STAY ORGANIZED</span>
        <h2>Ready for your next guest?</h2>
        <p>Keep your booking requests, guest documents, and check-in instructions up to date.</p>
    </div>

    <div class="host-dashboard-help-actions">
        <a asp-controller="Host" asp-action="Bookings" class="btn host-help-btn">
            View Bookings
        </a>
        <a asp-controller="Host" asp-action="Documents" class="host-help-link">
            Review Documents →
        </a>
    </div>
</section>

</div>
