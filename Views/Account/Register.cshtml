@model Staybnb.ViewModels.RegisterViewModel

@{
ViewData["Title"] = "Create Account";
}

<div class="auth-page">
    <div class="auth-container">

    <!-- Left: Welcome panel -->
    <div class="auth-welcome">
        <div class="auth-brand">
            <span class="auth-brand-icon">S</span>
            <span>Staybnb</span>
        </div>

        <div class="auth-welcome-content">
            <span class="auth-eyebrow">YOUR NEXT CHAPTER STARTS HERE</span>

            <h1>Make yourself at home.</h1>

            <p>
                Create your Staybnb account and discover places
                to stay, plan your next trip, and make every
                getaway count.
            </p>

            <div class="auth-feature">
                <span class="auth-feature-icon">✓</span>
                <span>Discover places for your next trip</span>
            </div>

            <div class="auth-feature">
                <span class="auth-feature-icon">✓</span>
                <span>Manage your bookings in one place</span>
            </div>

            <div class="auth-feature">
                <span class="auth-feature-icon">✓</span>
                <span>Join a growing community of travellers</span>
            </div>
        </div>

        <div class="auth-welcome-footer">
            Your next stay is closer than you think.
        </div>
    </div>

    <!-- Right: Registration form -->
    <div class="auth-form-panel">
        <div class="auth-form-content">

            <div class="auth-mobile-brand">
                <span class="auth-brand-icon">S</span>
                <span>Staybnb</span>
            </div>

            <div class="auth-heading">
                <span class="auth-eyebrow">GET STARTED</span>
                <h2>Create your account</h2>
                <p>Fill in your details to join Staybnb.</p>
            </div>

            <form asp-controller="Account"
                  asp-action="Register"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="auth-validation-summary">
                </div>

                <div class="auth-field">
                    <label asp-for="FullName" class="form-label">
                        Full name
                    </label>

                    <input asp-for="FullName"
                           class="form-control auth-input"
                           placeholder="Enter your full name"
                           autocomplete="name"
                           autofocus />

                    <span asp-validation-for="FullName"
                          class="text-danger auth-field-error"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Email" class="form-label">
                        Email address
                    </label>

                    <input asp-for="Email"
                           class="form-control auth-input"
                           placeholder="name@example.com"
                           autocomplete="email" />

                    <span asp-validation-for="Email"
                          class="text-danger auth-field-error"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="Password" class="form-label">
                        Password
                    </label>

                    <input asp-for="Password"
                           class="form-control auth-input"
                           placeholder="Create a password"
                           autocomplete="new-password" />

                    <span asp-validation-for="Password"
                          class="text-danger auth-field-error"></span>

                    <small class="auth-password-hint">
                        Use at least 8 characters, including uppercase,
                        lowercase, and a number.
                    </small>
                </div>

                <div class="auth-field">
                    <label asp-for="ConfirmPassword" class="form-label">
                        Confirm password
                    </label>

                    <input asp-for="ConfirmPassword"
                           class="form-control auth-input"
                           placeholder="Enter your password again"
                           autocomplete="new-password" />

                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger auth-field-error"></span>
                </div>

                <button type="submit" class="auth-submit-btn">
                    Create Account
                    <span aria-hidden="true">→</span>
                </button>

            </form>

            <div class="auth-divider">
                <span>ALREADY A MEMBER?</span>
            </div>

            <a asp-controller="Account"
               asp-action="Login"
               class="auth-register-btn">
                Sign in to your account
            </a>

            <p class="auth-terms">
                Create your account to explore properties and
                manage your Staybnb bookings.
            </p>

        </div>
    </div>

</div>

</div>

@section Scripts { <partial name="_ValidationScriptsPartial" />
}
