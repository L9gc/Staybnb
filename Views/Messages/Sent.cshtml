@model List<Staybnb.Models.Message>

@{
ViewData["Title"] = "Sent Messages";
}

<div class="messages-page">
    <div class="messages-header">
        <div>
            <span class="messages-eyebrow">STAYBNB MESSAGES</span>
            <h1>Sent Messages</h1>
            <p>Keep track of the messages you've sent to other Staybnb users.</p>
        </div>

    <a asp-action="Create" class="messages-compose-btn">
        <span class="messages-compose-icon">+</span>
        Compose Message
    </a>
</div>

<div class="messages-toolbar">
    <div class="messages-tabs">
        <a asp-action="Index" class="messages-tab">
            Inbox
        </a>

        <a asp-action="Sent" class="messages-tab active">
            Sent Messages
        </a>
    </div>

    <div class="messages-summary">
        <span class="messages-summary-dot"></span>
        @Model.Count message@(Model.Count == 1 ? "" : "s") sent
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="messages-empty">
        <div class="messages-empty-icon">
            <span>↗</span>
        </div>

        <h3>No messages sent yet</h3>

        <p>
            Messages you send to other Staybnb users will appear here.
            Start a conversation whenever you need to get in touch.
        </p>

        <a asp-action="Create" class="messages-empty-btn">
            Send Your First Message
        </a>
    </div>
}
else
{
    <div class="messages-list">
        @foreach (var message in Model)
        {
            <a asp-action="Details"
               asp-route-id="@message.Id"
               class="message-item">

                <div class="message-avatar">
                    @{
                        var receiverName = message.Receiver?.FullName
                            ?? message.Receiver?.Email
                            ?? "Unknown user";

                        var initials = string.Join(
                            "",
                            receiverName.Split(
                                ' ',
                                StringSplitOptions.RemoveEmptyEntries)
                            .Take(2)
                            .Select(part => char.ToUpperInvariant(part[0])));
                    }

                    @initials
                </div>

                <div class="message-main">
                    <div class="message-topline">
                        <span class="message-sender">
                            To: @receiverName
                        </span>

                        <span class="message-date">
                            @message.SentAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                        </span>
                    </div>

                    <div class="message-subject-row">
                        <h3>@message.Subject</h3>
                    </div>

                    <p class="message-preview">
                        @(message.Content.Length > 120
                            ? message.Content[..120] + "..."
                            : message.Content)
                    </p>
                </div>

                <div class="message-arrow" aria-hidden="true">
                    &#8250;
                </div>
            </a>
        }
    </div>
}

<div class="messages-footer-note">
    <span>Staybnb</span>
    <span>Your conversations, all in one place.</span>
</div>

</div>
