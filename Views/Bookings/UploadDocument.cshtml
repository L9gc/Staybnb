@model Staybnb.ViewModels.GuestDocumentViewModel

@{
    ViewData["Title"] = "Upload Document";
}

<div class="container py-4">
    <a asp-controller="Bookings"
       asp-action="MyBookings"
       class="btn btn-outline-secondary btn-sm mb-3">
        &larr; Back to My Bookings
    </a>

    <h1 class="fw-bold">Upload Document</h1>

    <p class="text-muted">
        Submit a document for your approved booking at
        <strong>@ViewBag.PropertyTitle</strong>.
    </p>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-4">

            @if (TempData["Message"] != null)
            {
                <div class="alert alert-info">
                    @TempData["Message"]
                </div>
            }

            <form asp-controller="Bookings"
                  asp-action="UploadDocument"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="BookingId" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="DocumentType"
                           class="form-label fw-semibold"></label>

                    <select asp-for="DocumentType"
                            class="form-select">
                        <option value="">Select a document type</option>
                        <option value="Identity Document">
                            Identity Document
                        </option>
                        <option value="Passport">
                            Passport
                        </option>
                        <option value="Other">
                            Other
                        </option>
                    </select>

                    <span asp-validation-for="DocumentType"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="File"
                           class="form-label fw-semibold"></label>

                    <input asp-for="File"
                           type="file"
                           class="form-control"
                           accept=".pdf,.jpg,.jpeg,.png" />

                    <div class="form-text">
                        Accepted formats: PDF, JPG and PNG.
                        Maximum size: 5 MB.
                    </div>

                    <span asp-validation-for="File"
                          class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-dark">
                    Upload Document
                </button>
            </form>
        </div>
    </div>
</div>