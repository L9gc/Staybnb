@model Staybnb.ViewModels.CreateBookingViewModel
@using Staybnb.Models
@using System.Globalization

@{
ViewData["Title"] = "Book Your Stay";
var property = ViewBag.Property as Property;
}

<div class="container py-5">
    <div class="mb-4">
        <a asp-controller="Properties"
           asp-action="Details"
           asp-route-id="@Model.PropertyId"
           class="text-decoration-none text-muted">
            &larr; Back to property
        </a>

    <h1 class="display-6 fw-bold mt-3">Book Your Stay</h1>
    <p class="text-muted">Enter your details to request a reservation.</p>
</div>

@if (property != null)
{
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h2 class="h4 fw-bold mb-4">Your reservation</h2>

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="PropertyId" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="CheckInDate" class="form-label"></label>
                            <input asp-for="CheckInDate"
                                   type="date"
                                   class="form-control" />
                            <span asp-validation-for="CheckInDate"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CheckOutDate" class="form-label"></label>
                            <input asp-for="CheckOutDate"
                                   type="date"
                                   class="form-control" />
                            <span asp-validation-for="CheckOutDate"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="NumberOfGuests" class="form-label"></label>
                            <input asp-for="NumberOfGuests"
                                   type="number"
                                   min="1"
                                   max="20"
                                   class="form-control" />
                            <span asp-validation-for="NumberOfGuests"
                                  class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-dark btn-lg w-100">
                            Request Booking
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <p class="text-muted small mb-2">YOUR SELECTED PROPERTY</p>

                    <h2 class="h4 fw-bold">@property.Title</h2>

                    <p class="text-muted">
                        @property.City · @property.PropertyType
                    </p>

                    <hr />

                    <div class="d-flex justify-content-between mb-3">
                        <span>Price per night</span>
                        <strong>
                            @property.PricePerNight.ToString("C", CultureInfo.GetCultureInfo("en-ZA"))
                        </strong>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span>Cleaning fee</span>
                        <strong>
                            @property.CleaningFee.ToString("C", CultureInfo.GetCultureInfo("en-ZA"))
                        </strong>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span>Service fee</span>
                        <strong>
                            @property.ServiceFee.ToString("C", CultureInfo.GetCultureInfo("en-ZA"))
                        </strong>
                    </div>

                    <hr />

                    <p class="small text-muted mb-0">
                        Your final total will be calculated by the server
                        using the selected dates and the property's current fees.
                    </p>
                </div>
            </div>
        </div>
    </div>
}

</div>

@section Scripts { <partial name="_ValidationScriptsPartial" />
}
