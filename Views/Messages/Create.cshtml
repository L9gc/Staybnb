@{ViewData["Title"] = "Compose Message";

var users = ViewBag.Users;
string? selectedReceiver = ViewBag.ReceiverId;
string? subject = ViewBag.Subject;
string? content = ViewBag.Content;


}

<div class="container mt-4 mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1>Compose Message</h1>
                <p class="text-muted">
                    Send a private message to another Staybnb user.
                </p>
            </div>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Back to Inbox
            </a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body p-4">

                <form asp-controller="Messages"
                      asp-action="Create"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="alert alert-danger"
                         role="alert"></div>

                    <div class="mb-3">
                        <label for="receiverId" class="form-label">
                            Recipient
                        </label>

                        <select id="receiverId"
                                name="receiverId"
                                class="form-select"
                                required>

                            <option value="">Select a recipient</option>

                            @foreach (var user in users)
                            {
                                <option value="@user.Id"
                                        selected="@(selectedReceiver == user.Id)">
                                    @(string.IsNullOrWhiteSpace((string?)user.FullName)
                                        ? user.Email
                                        : user.FullName)
                                </option>
                            }
                        </select>

                        <span class="text-danger">
                            @Html.ValidationMessage("receiverId")
                        </span>
                    </div>

                    <div class="mb-3">
                        <label for="subject" class="form-label">
                            Subject
                        </label>

                        <input type="text"
                               id="subject"
                               name="subject"
                               class="form-control"
                               maxlength="150"
                               value="@subject"
                               placeholder="Enter your subject"
                               required />

                        <span class="text-danger">
                            @Html.ValidationMessage("subject")
                        </span>
                    </div>

                    <div class="mb-4">
                        <label for="content" class="form-label">
                            Message
                        </label>

                        <textarea id="content"
                                  name="content"
                                  class="form-control"
                                  rows="7"
                                  maxlength="5000"
                                  placeholder="Write your message here..."
                                  required>@content</textarea>

                        <div class="form-text">
                            Maximum 5,000 characters.
                        </div>

                        <span class="text-danger">
                            @Html.ValidationMessage("content")
                        </span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancel
                        </a>

                        <button type="submit" class="btn btn-primary">
                            Send Message
                        </button>
                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

</div>

@section Scripts { <partial name="_ValidationScriptsPartial" />
}
